<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        app:implementationMode="performance"
        app:scaleType="fitCenter" />

    <com.netanel.roadwatch.ui.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Compact header. No large dashboard covering the camera. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ROADWATCH AI"
                    android:textColor="@color/rw_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="V4 · AUTO COUNT · NO SETUP"
                    android:textColor="@color/rw_blue"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="מאתחל..."
                    android:textColor="@color/rw_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/stat_bg"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/live_dot" />

                <TextView
                    android:id="@+id/txtLive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="OFFLINE"
                    android:textColor="@color/rw_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:weightSum="4">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/stat_bg"
                android:gravity="center"
                android:orientation="vertical">
                <TextView android:id="@+id/txtParkedNow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/rw_green" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="חונים" android:textColor="@color/rw_muted" android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/stat_bg"
                android:gravity="center"
                android:orientation="vertical">
                <TextView android:id="@+id/txtMovingNow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/rw_blue" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="בתנועה" android:textColor="@color/rw_muted" android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/stat_bg"
                android:gravity="center"
                android:orientation="vertical">
                <TextView android:id="@+id/txtPassedToday" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/rw_text" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="עברו היום" android:textColor="@color/rw_muted" android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:background="@drawable/stat_bg"
                android:gravity="center"
                android:orientation="vertical">
                <TextView android:id="@+id/txtParkedToday" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/rw_amber" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="חנו היום" android:textColor="@color/rw_muted" android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Only the controls stay at the bottom; about one row instead of a giant panel. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_gravity="bottom"
        android:layout_margin="10dp"
        android:background="@drawable/panel_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/txtZoom"
            android:layout_width="46dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="1.0×"
            android:textColor="@color/rw_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/zoomSeek"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="שליטה בזום" />

        <TextView
            android:id="@+id/txtActiveTracks"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="מעקב 0"
            android:textColor="@color/rw_muted"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/txtLeftToday"
            android:layout_width="58dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="יצאו 0"
            android:textColor="@color/rw_muted"
            android:textSize="9sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReset"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="64dp"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:text="איפוס"
            android:textColor="@color/rw_text"
            android:textSize="10sp"
            app:strokeColor="@color/rw_border" />
    </LinearLayout>

</FrameLayout>
